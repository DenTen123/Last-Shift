extends RefCounted
## Истории привязаны к персонажам, оговорки — к реальному состоянию гостя.
const STORIES := {
	"Глеб": "Я Глеб, инженер. До эвакуации обслуживал оборудование на станции. Моё укрытие затопило. Впустите — буду искать металл, провод и платы для вашей техники.",
	"Степан": "Степан. Работал инженером в ремонтной бригаде, пока цех не опустел. Ночевать там больше нельзя. Дайте место под крышей — в вылазках найду металл и провод.",
	"Пётр": "Я Пётр, повар из придорожной столовой. Запасы там кончились, а печь разрушена. Пустите к себе — умею готовить экономно, из той же картошки получим больше еды.",
	"Нина": "Я Нина, медик. После эвакуации помогала людям на перевалочном пункте, но его закрыли. Мне негде остаться. Впустите — помогу лечить раненых и пользоваться аптечками.",
	"Алла": "Алла, химик. Работала в лаборатории, пока здание не стало опасным. Ищу укрытие и работу. Могу увеличить выход топлива из картошки и брикетов — для машины это пригодится.",
	"Женя": "Меня зовут Женя, я радиотехник. На узле связи больше никого нет. Хочу переждать здесь и быть полезным человеком в команде: разбираюсь в радио и изготовлении плат.",
	"Ольга": "Я Ольга, охотница. Зимовье сгорело, возвращаться некуда. Мне нужна крыша над головой. Если примете, буду ходить на поверхность и приносить еду, когда удастся добыть.",
	"Данил": "Данил, разведчик. Ходил с караванами, знаю, как беречь силы в дороге. Караван ушёл без меня. Впустите — буду выходить за припасами, риск травм у меня ниже.",
	"Вера": "Я Вера, учительница. В школе был пункт укрытия, но людей оттуда вывезли. Я осталась без места. Пустите — помогу команде держаться, по утрам поддержу тех, кто совсем упал духом.",
	"Игорь": "Игорь, механик. Раньше работал в гараже у трассы, теперь там обвал. Мне нужно безопасное место. Впустите — в вылазках буду искать металл, резину и топливо для вашей машины.",
	"Тимур": "Я Тимур. Давно живу в дороге, специальности нет, зато могу много унести. Старое убежище промёрзло насквозь. Дайте угол — буду выходить за припасами и таскать тяжёлые грузы.",
}
const WARNINGS := {
	"sick": [
		"Только не подходите близко… Вчера начался жар, сегодня никак не могу согреться. У вас ведь найдётся аптечка?",
		"Кашель всё сильнее, и в прошлом укрытии после меня тоже начали кашлять. Но здесь же тепло — может, само пройдёт?",
		"Это просто насморк… наверное. Уже несколько дней ломит всё тело. Можно мне сразу к остальным, без осмотра?",
	],
	"maniac": [
		"Руку из кармана не выну. И про пятна на ноже лучше не спрашивайте. Главное — откройте, с остальными я сам договорюсь.",
		"Сколько вас внутри? По ночам кто-нибудь дежурит? В прошлом убежище мне тоже пытались указывать… больше некому.",
		"Обыскивать меня не надо. Нож останется при мне. Впустите, и пусть никто не трогает мои вещи — я за себя не отвечаю.",
	],
}

static func build(npc_name: String, status: String, variant: int) -> String:
	var story: String = STORIES.get(npc_name, "Мне негде укрыться. Впустите — буду помогать с припасами.")
	if WARNINGS.has(status):
		var lines: Array = WARNINGS[status]
		story += "\n\n" + String(lines[posmod(variant, lines.size())])
	return story
