static func story(npc_name: String) -> String:
	return String(VD.STORIES.get(npc_name, "Мне негде укрыться. Спасибо, что пустили."))


static func chat_line(prof: String, _who: String) -> String:
	var pool: Array = CHAT.get(prof, GENERIC)
	return String(pool[randi() % pool.size()])
